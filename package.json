{
  "name": "markup-generator",
  "version": "3.0.0",
  "description": "TypeScript helper to generate unique filenames and write HTML (or any text) content to disk.",
  "author": "Arthur Tkachenko",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "markup-generator": "./dist/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/write-newsletter.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "email",
    "html",
    "generator",
    "newsletter",
    "write-file",
    "typescript",
    "nodejs",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/markup-generator.git"
  }
}

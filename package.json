{
  "name": "markup-generator",
  "version": "3.2.0",
  "description": "TypeScript helper to generate unique filenames and write HTML (or any text) content to disk.",
  "author": "Arthur Tkachenko",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "markup-generator": "./dist/cli.cjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/write-newsletter.ts",
    "prepublishOnly": "pnpm test && pnpm run build",
    "lint": "eslint src || true",
    "turbo:build": "turbo run build",
    "turbo:test": "turbo run test",
    "turbo:lint": "turbo run lint"
  },
  "dependencies": {
    "@llazyemail/cli": "workspace:*",
    "@llazyemail/email": "workspace:*",
    "@llazyemail/fs": "workspace:*",
    "@llazyemail/read": "workspace:*",
    "@llazyemail/template": "workspace:*",
    "@llazyemail/write": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0",
    "turbo": "^2.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "email",
    "html",
    "generator",
    "newsletter",
    "write-file",
    "typescript",
    "nodejs",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/markup-generator.git"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

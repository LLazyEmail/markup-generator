{
  "name": "@llazyemail/core",
  "version": "4.0.0",
  "description": "Reserved scope name (stub, not published). The v4 core barrel is the root `markup-generator` package.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --no-config --format esm,cjs --dts --clean --target node20 --platform node",
    "test": "node --input-type=module -e \"import('./dist/index.js').then((m) => { if (m.PHASE0_STUB !== true) process.exit(1); console.log('@llazyemail/core stub ok'); })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "license": "MIT",
  "author": "Arthur Tkachenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/markup-generator.git",
    "directory": "packages/core"
  },
  "private": true
}

{
  "name": "@llazyemail/cli",
  "version": "4.0.0",
  "description": "CLI / argv helpers for markup-generator (parseArgv, bin)",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --no-config --format esm,cjs --dts --clean --target node20 --platform node",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --no-warn-ignored"
  },
  "dependencies": {
    "@llazyemail/write": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "license": "MIT",
  "author": "Arthur Tkachenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/markup-generator.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": true
}

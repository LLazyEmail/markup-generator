{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@llazyemail/fs": [
        "packages/fs/src/index.ts"
      ],
      "@llazyemail/write": [
        "packages/write/src/index.ts"
      ],
      "@llazyemail/read": [
        "packages/read/src/index.ts"
      ],
      "@llazyemail/email": [
        "packages/email/src/index.ts"
      ],
      "@llazyemail/cli": [
        "packages/cli/src/index.ts"
      ],
      "@llazyemail/template": [
        "packages/template/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "tests",
    "dist"
  ]
}
